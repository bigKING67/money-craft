{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/money-craft/schemas/company-research-plan.schema.json",
  "title": "Money Craft company research plan",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "identity",
    "as_of",
    "latest_report_period",
    "latest_annual_period",
    "provider",
    "execution_boundary",
    "stages",
    "official_evidence_requirements",
    "provider_operations",
    "artifact_contract",
    "completion_gate"
  ],
  "properties": {
    "schema": {"const": "money-craft.company-research-plan.v1"},
    "mode": {"const": "research"},
    "identity": {
      "type": "object",
      "required": ["security", "thscode", "ticker", "exchange", "share_class", "base_currency"],
      "properties": {
        "security": {"type": "string", "minLength": 1},
        "thscode": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"},
        "ticker": {"type": "string", "pattern": "^[0-9]{6}$"},
        "exchange": {"enum": ["SSE", "SZSE", "BSE"]},
        "share_class": {"const": "A-share"},
        "base_currency": {"const": "CNY"}
      },
      "additionalProperties": false
    },
    "as_of": {"type": "string", "format": "date"},
    "latest_report_period": {"type": "string", "pattern": "^(19|20)[0-9]{2}-[1-4]$"},
    "latest_annual_period": {"type": "string", "pattern": "^(19|20)[0-9]{2}-4$"},
    "provider": {"type": "object"},
    "execution_boundary": {"type": "object"},
    "stages": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "official_evidence_requirements": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "provider_operations": {"type": "array", "minItems": 13, "items": {"type": "object"}},
    "artifact_contract": {"type": "object"},
    "completion_gate": {"type": "object"}
  },
  "additionalProperties": false
}
