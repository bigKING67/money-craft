{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigKING67/money-craft/schemas/research-completion-receipt.schema.json",
  "title": "Money Craft research completion receipt",
  "type": "object",
  "required": [
    "schema",
    "valid",
    "run_id",
    "completed_at",
    "plan_sha256",
    "bindings",
    "provider_gaps",
    "automatic_trading"
  ],
  "properties": {
    "schema": {"const": "money-craft.research-completion-receipt.v1"},
    "valid": {"const": true},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "completed_at": {"type": "string", "format": "date-time"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bindings": {
      "type": "object",
      "minProperties": 9,
      "maxProperties": 11,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "provider_gaps": {"type": "array", "items": {"type": "string"}},
    "automatic_trading": {"const": false}
  },
  "additionalProperties": false
}
